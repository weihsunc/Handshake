    "Contracts you create will show up here —\ndrafts, pending signatures, and signed.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你建立的合約會顯示在這裡——\n草稿、待簽署和已簽署的合約。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
