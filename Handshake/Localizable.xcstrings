    "You'll sign with %@ before it's sent, so recipients see your signature in place.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送前你會先使用 %@ 簽署，讓收件人看到你的簽名已就位。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送前你会先使用 %@ 签署，让收件人看到你的签名已就位。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信前に%@で署名するので、受信者にはあなたの署名が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내기 전에 %@(으)로 서명하므로 수신자는 내 서명이 들어간 계약서를 보게 돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmarás con %@ antes de enviarlo, para que los destinatarios vean tu firma en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous signerez avec %@ avant l’envoi, pour que les destinataires voient votre signature en place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du signierst vor dem Senden mit %@, damit Empfänger deine Unterschrift schon sehen."
          }
        }
      }
    },
    "You're signing as %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你以 %@ 身分簽署"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你以 %@ 身份签署"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@として署名します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(으)로 서명합니다"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmas como %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous signez en tant que %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du signierst als %@"
          }
        }
      }
    },
    "You've been invited to review and sign the following agreement:": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你受邀審閱並簽署以下協議："
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你受邀审阅并签署以下协议："
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の契約の確認と署名の依頼が届いています："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 계약서의 검토와 서명 요청이 도착했어요:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te han invitado a revisar y firmar el siguiente acuerdo:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez été invité à lire et signer l’accord suivant :"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wurdest eingeladen, die folgende Vereinbarung zu prüfen und zu signieren:"
          }
        }
      }
    },
    "You've been invited to sign \"%@\". Open it in the Handshake app to review and sign with Face ID:\n%@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你受邀簽署「%@」。請在 Handshake App 中開啟，審閱後以 Face ID 簽署：\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你受邀签署“%@”。请在 Handshake App 中打开，审阅后以 面容 ID 签署：\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」への署名依頼が届いています。Handshakeアプリで開き、Face IDで内容を確認して署名してください。\n%2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" 서명 요청이 도착했어요. Handshake 앱에서 열어 내용을 확인하고 Face ID로 서명하세요.\n%2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te han invitado a firmar «%@». Ábrelo en la app Handshake para revisarlo y firmarlo con Face ID:\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez été invité à signer « %@ ». Ouvrez-le dans l’app Handshake pour le lire et le signer avec Face ID :\n%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wurdest eingeladen, „%@“ zu signieren. Öffne es in der Handshake-App, um es zu prüfen und mit Face ID zu signieren:\n%@"
          }
        }
      }
    },
    "Your contracts stay on this %@.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
