    "Billing is handled by Apple. Payments, renewals, cancellations and refunds are managed in your Apple Account.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳單由 Apple 處理。付款、續訂、取消和退款都可以在你的 Apple 帳號中管理。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账单由 Apple 处理。付款、续订、取消和退款都可以在你的 Apple 账户中管理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "請求はAppleが処理します。支払い、更新、キャンセル、返金はApple Accountで管理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제는 Apple에서 처리해요. 결제, 갱신, 취소, 환불은 Apple 계정에서 관리돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple se encarga de la facturación. Los pagos, renovaciones, cancelaciones y reembolsos se gestionan en tu cuenta de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La facturation est gérée par Apple. Les paiements, renouvellements, résiliations et remboursements se gèrent dans votre compte Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Abrechnung läuft über Apple. Zahlungen, Verlängerungen, Kündigungen und Rückerstattungen verwaltest du in deinem Apple-Account."
          }
        }
      }
    },
