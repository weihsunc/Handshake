{
  "sourceLanguage": "en",
  "strings": {
    "%@\n\nOpen in Handshake to record it:\n%@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n在 Handshake 中開啟以記錄：\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n在 Handshake 中打开以记录：\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nHandshakeで開いて記録してください：\n%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nHandshake에서 열어 기록하세요:\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nÁbrelo en Handshake para registrarlo:\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nOuvrez-le dans Handshake pour l’enregistrer :\n%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nÖffne es in Handshake, um es zu erfassen:\n%@"
          }
        }
      }
    },
    "%@ and %lld more": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 及另外 %lld 項"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 及另外 %lld 项"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ほか%lld件"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 외 %lld개"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ y %lld más"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ et %lld autres"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ und %lld weitere"
          }
        }
      }
    },
    "%@ asked for changes": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 要求修改"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 要求修改"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が修正を依頼しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님이 수정을 요청했어요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pidió cambios"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a demandé des modifications"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat Änderungen angefragt"
          }
        }
      }
    },
    "%@ asked for changes to \"%@\":\n\n%@\n\nOpen in Handshake to revise it:\n%@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 要求修改「%2$@」：\n\n%3$@\n\n在 Handshake 中開啟以修訂：\n%4$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 要求修改“%2$@”：\n\n%3$@\n\n在 Handshake 中打开以修订：\n%4$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が「%2$@」の修正を依頼しました：\n\n%3$@\n\nHandshakeで開いて修正してください：\n%4$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 님이 \"%2$@\"의 수정을 요청했어요:\n\n%3$@\n\nHandshake에서 열어 수정하세요:\n%4$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pidió cambios en \"%2$@\":\n\n%3$@\n\nÁbrelo en Handshake para revisarlo:\n%4$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a demandé des modifications à « %2$@ » :\n\n%3$@\n\nOuvrez-le dans Handshake pour le réviser :\n%4$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat Änderungen an „%2$@“ angefragt:\n\n%3$@\n\nÖffne es in Handshake, um es zu überarbeiten:\n%4$@"
          }
        }
      }
    },
    "%@ asked for these changes: %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 要求以下修改：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 要求以下修改：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@からの修正依頼：%2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 님의 수정 요청: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pidió estos cambios: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a demandé ces modifications : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat diese Änderungen angefragt: %@"
          }
        }
      }
    },
    "%@ declined to sign": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒絕簽署"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒绝签署"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が署名を辞退しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님이 서명을 거절했어요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rechazó firmar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a refusé de signer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat das Signieren abgelehnt"
          }
        }
      }
    },
    "%@ declined to sign \"%@\".": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 拒絕簽署「%2$@」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 拒绝签署“%2$@”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が「%2$@」への署名を辞退しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 님이 \"%2$@\" 서명을 거절했어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rechazó firmar \"%@\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a refusé de signer « %@ »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat abgelehnt, „%@“ zu signieren."
          }
        }
      }
    },
    "%@ declined to sign \"%@\": %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 拒絕簽署「%2$@」：%3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 拒绝签署“%2$@”：%3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が「%2$@」への署名を辞退しました：%3$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 님이 \"%2$@\" 서명을 거절했어요: %3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rechazó firmar \"%@\": %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a refusé de signer « %@ » : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat abgelehnt, „%@“ zu signieren: %@"
          }
        }
      }
    },
    "%@ invited you to review and sign the following agreement:": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 邀請你審閱並簽署以下協議："
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 邀请你审阅并签署以下协议："
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さんから、次の契約の確認と署名の依頼が届いています："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님이 다음 계약서의 검토와 서명을 요청했어요:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te ha invitado a revisar y firmar el siguiente acuerdo:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vous a invité à lire et signer l’accord suivant :"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat dich eingeladen, die folgende Vereinbarung zu prüfen und zu signieren:"
          }
        }
      }
    },
    "%@ invited you to sign \"%@\". Open it in the Handshake app to review and sign with Face ID:\n%@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 邀請你簽署「%@」。請在 Handshake App 中開啟，審閱後以 Face ID 簽署：\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 邀请你签署“%@”。请在 Handshake App 中打开，审阅后以 面容 ID 签署：\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@さんから「%2$@」への署名依頼が届いています。Handshakeアプリで開き、Face IDで内容を確認して署名してください。\n%3$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@님이 \"%2$@\" 서명을 요청했어요. Handshake 앱에서 열어 내용을 확인하고 Face ID로 서명하세요.\n%3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te ha invitado a firmar «%@». Ábrelo en la app Handshake para revisarlo y firmarlo con Face ID:\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vous a invité à signer « %@ ». Ouvrez-le dans l’app Handshake pour le lire et le signer avec Face ID :\n%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat dich eingeladen, „%@“ zu signieren. Öffne es in der Handshake-App, um es zu prüfen und mit Face ID zu signieren:\n%@"
          }
        }
      }
    },
    "%@ signed \"%@\" with %@.\n\nOpen in Handshake to record the signature:\n%@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已使用 %3$@ 簽署「%2$@」。\n\n請在 Handshake 中開啟以記錄簽名：\n%4$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已使用 %3$@ 签署“%2$@”。\n\n请在 Handshake 中打开以记录签名：\n%4$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@さんが「%2$@」に%3$@で署名しました。\n\nHandshakeで開いて署名を記録してください：\n%4$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@님이 \"%2$@\"에 %3$@(으)로 서명했어요.\n\nHandshake에서 열어 서명을 기록하세요:\n%4$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ firmó «%@» con %@.\n\nÁbrelo en Handshake para registrar la firma:\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a signé « %@ » avec %@.\n\nOuvrez-le dans Handshake pour enregistrer la signature :\n%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat „%@“ mit %@ signiert.\n\nÖffne es in Handshake, um die Signatur zu erfassen:\n%@"
          }
        }
      }
    },
    "%@ still need filling in. Cancel to edit the contract, or send it as it is.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仍需填寫。取消即可編輯合約，或照現狀傳送。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仍需填写。取消即可编辑合同，或按现状发送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がまだ空欄です。キャンセルして契約書を編集するか、このまま送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 아직 비어 있어요. 취소하고 계약서를 편집하거나 그대로 보내세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún falta completar %@. Cancela para editar el contrato o envíalo tal como está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ restent à compléter. Annulez pour modifier le contrat, ou envoyez-le tel quel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ müssen noch ausgefüllt werden. Tippe auf „Abbrechen“, um den Vertrag zu bearbeiten, oder sende ihn so, wie er ist."
          }
        }
      }
    },
    "%lld blanks still to fill in": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還有 %lld 處空白待填"
