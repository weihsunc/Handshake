    "Only your recipients sign. You'll get the signed copy back.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有收件人需要簽署。已簽署的副本會傳回給你。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有收件人需要签署。已签署的副本会发回给你。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名するのは受信者だけです。署名済みのコピーが返送されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수신자만 서명해요. 서명된 사본은 나에게 돌아와요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo firman tus destinatarios. Recibirás la copia firmada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls vos destinataires signent. Vous recevrez la copie signée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur deine Empfänger signieren. Du bekommst die signierte Kopie zurück."
          }
        }
      }
