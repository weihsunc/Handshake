        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verträge, die du erstellst, erscheinen hier:\nEntwürfe, ausstehende Signaturen und signierte."
          }
        }
      }
    },
    "Couldn't hear anything. Check the microphone and try again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有聽到任何聲音。請檢查麥克風後再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有听到任何声音。请检查麦克风后再试一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
