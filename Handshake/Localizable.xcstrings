    "Handshake can't confirm delivery through the share sheet. Marking it sent moves it to Pending Signature.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake 無法透過分享選單確認是否已送達。標示為已傳送後，合約會移到「待簽署」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake 无法通过共享菜单确认是否已送达。标记为已发送后，合同会移到“待签署”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshakeは共有シート経由の配信を確認できません。送信済みにすると「署名待ち」に移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake는 공유 시트를 통한 전달 여부를 확인할 수 없어요. 보냄으로 표시하면 서명 대기 중으로 이동해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake no puede confirmar la entrega desde la hoja para compartir. Si lo marcas como enviado, pasará a Firma pendiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake ne peut pas confirmer la livraison via la feuille de partage. Le marquer comme envoyé le place dans Signature en attente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake kann die Zustellung über das Teilen-Menü nicht bestätigen. Als gesendet markiert, wird der Vertrag zu „Signatur ausstehend“."
          }
        }
      }
    },
