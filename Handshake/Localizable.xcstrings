    "No one is signing as %@. Choose it for yourself or a recipient, or delete the extra signature box.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有人以 %@ 身分簽署。請選擇由你或某位收件人簽署，或刪除多餘的簽名欄。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有人以 %@ 身份签署。请选择由你或某位收件人签署，或删除多余的签名框。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@として署名する人がいません。自分か受信者を選ぶか、余分な署名ボックスを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(으)로 서명할 사람이 없어요. 나 또는 수신자를 선택하거나 남는 서명란을 삭제하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie firma como %@. Elígelo para ti o para un destinatario, o elimina el cuadro de firma sobrante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne signe en tant que %@. Attribuez-le à vous-même ou à un destinataire, ou supprimez le champ de signature en trop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand signiert als %@. Wähle dich selbst oder einen Empfänger, oder lösche das überzählige Signaturfeld."
          }
        }
      }
    },
