    "Tell %@ what you'd like changed. They can revise it and send you a new version.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴 %@ 你想修改哪些內容。對方可以修訂後再傳送新版本給你。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉 %@ 你想修改哪些内容。对方可以修订后再给你发送新版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に修正してほしい内容を伝えてください。修正後、新しい版が送られてきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에게 수정할 내용을 알려 주세요. 수정한 새 버전을 다시 받을 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile a %@ qué quieres cambiar. Podrá revisarlo y enviarte una nueva versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites à %@ ce que vous souhaitez modifier. Cette personne pourra le réviser et vous envoyer une nouvelle version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag %@, was du geändert haben möchtest. Der Vertrag kann überarbeitet und dir neu geschickt werden."
          }
        }
      }
    },
