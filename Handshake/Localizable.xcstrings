    "Hi,\n\n%@\n\n%@\n\nTap the link below to open it in the Handshake app and sign with Face ID:\n%@\n\nThe link opens in Handshake, so you'll need the app installed on your iPhone or iPad.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你好，\n\n%@\n\n%@\n\n點一下下方連結，即可在 Handshake App 中開啟並以 Face ID 簽署：\n%@\n\n連結會在 Handshake 中開啟，因此你的 iPhone 或 iPad 需要已安裝此 App。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你好，\n\n%@\n\n%@\n\n轻点下方链接，即可在 Handshake App 中打开并以 面容 ID 签署：\n%@\n\n链接会在 Handshake 中打开，因此你的 iPhone 或 iPad 需要已安装此 App。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こんにちは。\n\n%1$@\n\n%2$@\n\n下のリンクをタップしてHandshakeアプリで開き、Face IDで署名してください。\n%3$@\n\nリンクはHandshakeで開くため、iPhoneまたはiPadにアプリが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안녕하세요.\n\n%1$@\n\n%2$@\n\n아래 링크를 탭하면 Handshake 앱에서 열려요. Face ID로 서명하세요.\n%3$@\n\n링크는 Handshake에서 열리므로 iPhone 또는 iPad에 앱이 설치되어 있어야 해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hola:\n\n%@\n\n%@\n\nToca el enlace de abajo para abrirlo en la app Handshake y firmar con Face ID:\n%@\n\nEl enlace se abre en Handshake, así que necesitarás la app instalada en tu iPhone o iPad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour,\n\n%@\n\n%@\n\nTouchez le lien ci-dessous pour l’ouvrir dans l’app Handshake et signer avec Face ID :\n%@\n\nLe lien s’ouvre dans Handshake : l’app doit donc être installée sur votre iPhone ou iPad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo,\n\n%@\n\n%@\n\nTippe auf den Link unten, um ihn in der Handshake-App zu öffnen und mit Face ID zu signieren:\n%@\n\nDer Link öffnet sich in Handshake, du brauchst also die App auf deinem iPhone oder iPad."
          }
        }
      }
    },
