    "API error (status %lld). Check your key in Secrets.swift.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API 錯誤（狀態碼 %lld）。請檢查 Secrets.swift 中的金鑰。"
          }
        },
        "zh-Hans": {
