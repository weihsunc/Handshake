    "Draft a comprehensive employment contract covering job title, compensation, benefits, working hours, confidentiality, non-compete clauses, and termination conditions.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請擬定一份完整的僱傭合約，涵蓋職稱、薪酬、福利、工作時間、保密、競業禁止條款與終止條件。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请起草一份完整的劳动合同，涵盖职位名称、薪酬、福利、工作时间、保密、竞业限制条款和终止条件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "職名、報酬、福利厚生、勤務時間、秘密保持、競業避止条項、終了条件を網羅した雇用契約書を作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직책, 보수, 복리후생, 근무 시간, 비밀 유지, 경업 금지 조항, 해지 조건을 포괄하는 고용 계약서를 작성해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redacta un contrato de trabajo completo que cubra el puesto, la remuneración, los beneficios, el horario, la confidencialidad, las cláusulas de no competencia y las condiciones de despido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédige un contrat de travail complet couvrant le poste, la rémunération, les avantages, les horaires, la confidentialité, les clauses de non-concurrence et les conditions de rupture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfasse einen umfassenden Arbeitsvertrag mit Stellenbezeichnung, Vergütung, Zusatzleistungen, Arbeitszeiten, Vertraulichkeit, Wettbewerbsverbot und Kündigungsbedingungen."
          }
        }
      }
    },
    "Drafting the clauses": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在擬定條款"
          }
        },
