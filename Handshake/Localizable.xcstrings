    "Create a contract for a freelance web development project that includes project scope, timeline, payment terms, deliverables, and confidentiality agreements.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請建立一份自由接案網站開發專案的合約，包含專案範圍、時程、付款條件、交付項目與保密協議。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请创建一份自由职业网站开发项目的合同，包含项目范围、时间表、付款条款、交付成果和保密协议。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フリーランスのWeb開発プロジェクトの契約書を作成してください。プロジェクトの範囲、スケジュール、支払条件、成果物、秘密保持の取り決めを含めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리랜서 웹 개발 프로젝트 계약서를 만들어 주세요. 프로젝트 범위, 일정, 지급 조건, 납품물, 비밀 유지 합의를 포함해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un contrato para un proyecto freelance de desarrollo web que incluya alcance del proyecto, calendario, condiciones de pago, entregables y acuerdos de confidencialidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un contrat pour un projet de développement web en freelance, avec le périmètre du projet, le calendrier, les conditions de paiement, les livrables et des clauses de confidentialité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle einen Vertrag für ein freiberufliches Webentwicklungsprojekt mit Projektumfang, Zeitplan, Zahlungsbedingungen, Liefergegenständen und Vertraulichkeitsvereinbarungen."
          }
        }
      }
    },
    "Create a lease agreement for an apartment with monthly rent, security deposit, lease term, utilities included, maintenance responsibilities, and standard rights and obligations.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請建立一份公寓租賃合約，包含每月租金、押金、租期、含水電瓦斯與否、維修責任，以及一般權利與義務。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请创建一份公寓租赁合同，包含月租金、押金、租期、包含的水电燃气费用、维修责任，以及一般权利和义务。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アパートの賃貸借契約書を作成してください。月額家賃、敷金、契約期間、含まれる光熱費、維持管理の責任、一般的な権利と義務を含めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아파트 임대차 계약서를 만들어 주세요. 월세, 보증금, 계약 기간, 포함된 공과금, 유지 보수 책임, 일반적인 권리와 의무를 포함해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un contrato de arrendamiento de un apartamento con alquiler mensual, fianza, duración del contrato, suministros incluidos, responsabilidades de mantenimiento y los derechos y obligaciones habituales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un bail pour un appartement avec le loyer mensuel, le dépôt de garantie, la durée du bail, les charges incluses, les responsabilités d’entretien et les droits et obligations habituels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle einen Mietvertrag für eine Wohnung mit monatlicher Miete, Kaution, Mietdauer, enthaltenen Nebenkosten, Instandhaltungspflichten sowie den üblichen Rechten und Pflichten."
          }
        }
      }
    },
    "Create a partnership agreement outlining roles, profit sharing, decision-making authority, capital contributions, dispute resolution, and exit procedures.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請建立一份合夥協議，說明各方角色、利潤分配、決策權限、出資、爭議解決與退出程序。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请创建一份合伙协议，说明各方角色、利润分配、决策权限、出资、争议解决和退出程序。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "役割、利益配分、意思決定の権限、出資、紛争解決、脱退の手続きをまとめたパートナーシップ契約書を作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "역할, 이익 배분, 의사 결정 권한, 출자, 분쟁 해결, 탈퇴 절차를 정리한 동업 계약서를 만들어 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un acuerdo de sociedad que describa las funciones, el reparto de beneficios, la capacidad de decisión, las aportaciones de capital, la resolución de disputas y los procedimientos de salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un contrat d’association décrivant les rôles, le partage des bénéfices, le pouvoir de décision, les apports en capital, la résolution des litiges et les modalités de sortie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle eine Partnerschaftsvereinbarung mit Rollen, Gewinnverteilung, Entscheidungsbefugnis, Kapitaleinlagen, Streitbeilegung und Ausstiegsregelungen."
          }
        }
      }
    },
    "Created! Feel free to edit directly on the contract or ask me to update it for you!": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成了！你可以直接在合約上編輯，或請我幫你更新！"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已创建！你可以直接在合同上编辑，或让我帮你更新！"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成しました！契約書を直接編集するか、更新をお任せください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만들었어요! 계약서를 직접 편집하거나 업데이트를 요청해 보세요!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Listo! Puedes editar directamente en el contrato o pedirme que lo actualice por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est fait ! Vous pouvez modifier directement le contrat ou me demander de le mettre à jour pour vous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt! Du kannst den Vertrag direkt bearbeiten oder mich bitten, ihn für dich zu aktualisieren."
          }
        }
      }
    },
