    "Signatures are confirmed with %@ and completed through %@.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽署會透過 %@ 確認，並透過 %@ 完成。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签署会通过 %@ 确认，并通过 %@ 完成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名は%1$@で確認され、%2$@を通じて完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명은 %1$@(으)로 확인하고 %2$@을(를) 통해 완료돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las firmas se confirman con %@ y se completan a través de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les signatures sont confirmées avec %@ et finalisées via %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaturen werden mit %@ bestätigt und über %@ abgeschlossen."
          }
        }
      }
    },
    "Signatures are confirmed with %@. Handshake keeps a fingerprint of each signature on this %@; no third party holds a copy.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽署會透過 %@ 確認。Handshake 會在這部 %@ 上保存每個簽名的指紋，沒有任何第三方持有副本。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签署会通过 %@ 确认。Handshake 会在这部 %@ 上保存每个签名的指纹，没有任何第三方持有副本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名は%1$@で確認されます。Handshakeは各署名のフィンガープリントをこの%2$@に保存し、第三者がコピーを保持することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명은 %1$@(으)로 확인해요. Handshake는 각 서명의 지문을 이 %2$@에 보관하며, 제3자는 사본을 보유하지 않아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las firmas se confirman con %@. Handshake guarda una huella de cada firma en este %@; ningún tercero conserva una copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les signatures sont confirmées avec %@. Handshake conserve une empreinte de chaque signature sur cet %@ ; aucun tiers n’en détient de copie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaturen werden mit %@ bestätigt. Handshake speichert einen Fingerabdruck jeder Signatur auf diesem %@; keine Drittpartei besitzt eine Kopie."
          }
        }
      }
    },
