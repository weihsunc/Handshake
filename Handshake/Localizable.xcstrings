    },
    "That link isn't a signing link.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個連結不是簽署連結。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个链接不是签署链接。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクは署名用のリンクではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명 링크가 아니에요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese enlace no es un enlace de firma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien n’est pas un lien de signature."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Link ist kein Signaturlink."
          }
        }
      }
    },
    "The AI declined this request. Try describing the agreement differently.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 拒絕了這個請求。請換個方式描述協議內容。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 拒绝了这个请求。请换个方式描述协议内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIはこのリクエストに応じられませんでした。合意内容の説明を変えてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI가 이 요청을 거절했어요. 계약 내용을 다르게 설명해 보세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA rechazó esta petición. Prueba a describir el acuerdo de otra manera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA a refusé cette demande. Essayez de décrire l’accord autrement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI hat diese Anfrage abgelehnt. Beschreibe die Vereinbarung anders."
          }
        }
      }
    },
    "The AI didn't return a usable contract. Try rephrasing your request or sending it again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 沒有產生可用的合約。請換個方式描述，或再傳送一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 没有生成可用的合同。请换个方式描述，或再发送一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIが使える契約書を返しませんでした。言い方を変えるか、もう一度送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI가 사용할 수 있는 계약서를 만들지 못했어요. 요청을 다르게 표현하거나 다시 보내 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA no devolvió un contrato utilizable. Prueba a reformular tu petición o envíala de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA n’a pas renvoyé de contrat exploitable. Essayez de reformuler votre demande ou renvoyez-la."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI hat keinen brauchbaren Vertrag geliefert. Formuliere deine Anfrage um oder sende sie erneut."
          }
        }
      }
    },
    "The recipient": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收件人"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收件人"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信者"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수신자"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El destinatario"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le destinataire"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Empfänger"
          }
        }
      }
    },
    "The sender is told you declined, with your reason if you give one.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寄件人會收到你拒絕的通知，以及你提供的原因。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发件人会收到你拒绝的通知，以及你提供的原因。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞退したことと、入力した場合はその理由が送信者に伝えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거절했다는 사실과 입력한 사유가 보낸 사람에게 전달돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se avisará al remitente de que rechazaste, con tu motivo si lo indicas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’expéditeur sera informé de votre refus, avec votre motif si vous en indiquez un."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Absender erfährt, dass du abgelehnt hast – mit deinem Grund, falls du einen angibst."
          }
        }
      }
    },
    "This contract has %lld signature boxes, one per signer. Remove a recipient, or add a box for them.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此合約有 %lld 個簽名欄，每位簽署人一個。請移除一位收件人，或為其加入簽名欄。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此合同有 %lld 个签名框，每位签署人一个。请移除一位收件人，或为其添加签名框。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この契約書には署名ボックスが%lld個あり、署名者ごとに1つです。受信者を削除するか、その人の署名ボックスを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계약서에는 서명자마다 하나씩 서명란이 %lld개 있어요. 수신자를 삭제하거나 서명란을 추가하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este contrato tiene %lld cuadros de firma, uno por firmante. Quita un destinatario o añade un cuadro para él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce contrat comporte %lld champs de signature, un par signataire. Retirez un destinataire, ou ajoutez-lui un champ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Vertrag hat %lld Signaturfelder, eins pro Unterzeichner. Entferne einen Empfänger oder füge ein Feld für ihn hinzu."
          }
        }
      }
    },
    "This link doesn't contain the contract. Ask the sender to send it again from the latest version of Handshake.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個連結不包含合約。請請寄件者使用最新版本的 Handshake 重新傳送。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个链接不包含合同。请让发送者使用最新版本的 Handshake 重新发送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクには契約書が含まれていません。送信者に、最新バージョンのHandshakeからもう一度送ってもらってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 링크에는 계약서가 들어 있지 않아요. 보낸 사람에게 최신 버전의 Handshake에서 다시 보내 달라고 요청하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace no contiene el contrato. Pide al remitente que lo envíe de nuevo desde la última versión de Handshake."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien ne contient pas le contrat. Demandez à l’expéditeur de le renvoyer depuis la dernière version de Handshake."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Link enthält den Vertrag nicht. Bitte den Absender, ihn mit der neuesten Version von Handshake erneut zu senden."
          }
        }
      }
    },
    "This link is incomplete. It may have been cut off when it was copied or forwarded. Ask the sender to send it again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個連結不完整，可能在複製或轉寄時被截斷了。請請寄件者重新傳送。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个链接不完整，可能在复制或转发时被截断了。请让发送者重新发送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクは不完全です。コピーや転送の途中で切れた可能性があります。送信者にもう一度送ってもらってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크가 완전하지 않아요. 복사하거나 전달하는 중에 잘렸을 수 있어요. 보낸 사람에게 다시 보내 달라고 요청하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace está incompleto. Puede que se haya cortado al copiarlo o reenviarlo. Pide al remitente que lo envíe de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien est incomplet. Il a peut-être été coupé lors de sa copie ou de son transfert. Demandez à l’expéditeur de le renvoyer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Link ist unvollständig. Möglicherweise wurde er beim Kopieren oder Weiterleiten abgeschnitten. Bitte den Absender, ihn erneut zu senden."
          }
        }
      }
    },
