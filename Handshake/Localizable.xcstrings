    "Generate a clear, professional Non-Disclosure Agreement (NDA) covering parties, confidential information, obligations, duration, exclusions, remedies, and jurisdiction.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請產生一份清楚、專業的保密協議（NDA），涵蓋當事人、機密資訊、義務、期限、排除事項、救濟方式與管轄地。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请生成一份清晰、专业的保密协议（NDA），涵盖当事人、保密信息、义务、期限、除外情形、救济措施和管辖地。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "当事者、秘密情報、義務、期間、除外事項、救済措置、管轄を含む、わかりやすく専門的な秘密保持契約書（NDA）を作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당사자, 기밀 정보, 의무, 기간, 제외 사항, 구제 수단, 관할을 포함한 명확하고 전문적인 비밀 유지 계약서(NDA)를 작성해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera un acuerdo de confidencialidad (NDA) claro y profesional que cubra las partes, la información confidencial, las obligaciones, la duración, las exclusiones, los recursos y la jurisdicción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Génère un accord de confidentialité (NDA) clair et professionnel couvrant les parties, les informations confidentielles, les obligations, la durée, les exclusions, les recours et la juridiction."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle eine klare, professionelle Geheimhaltungsvereinbarung (NDA) mit Vertragsparteien, vertraulichen Informationen, Pflichten, Laufzeit, Ausnahmen, Rechtsbehelfen und Gerichtsstand."
          }
        }
      }
    },
    "Generating your contract": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
