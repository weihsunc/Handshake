    "Handshake can take screenshots, photos, text, PDFs and exported chats.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake 可以接收截圖、照片、文字、PDF 和匯出的聊天紀錄。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake 可以接收截图、照片、文字、PDF 和导出的聊天记录。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshakeはスクリーンショット、写真、テキスト、PDF、書き出したトークを受け取れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake는 스크린샷, 사진, 텍스트, PDF, 내보낸 대화를 받을 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake acepta capturas, fotos, texto, PDF y chats exportados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake accepte les captures, photos, textes, PDF et discussions exportées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake nimmt Screenshots, Fotos, Text, PDFs und exportierte Chats an."
          }
        }
      }
    },
    "Open Handshake to finish your draft.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 Handshake 完成你的草稿。"
